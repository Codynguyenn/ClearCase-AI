# ClearCase environment configuration
# Copy this file to `.env` (which is git-ignored) and adjust values.
# Every setting has a safe local default; nothing here is required to run demo mode.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Connection string for the application database. Local default works with
# `scripts/dev_mongo.sh start` (native) or `docker compose up mongo`.
CLEARCASE_MONGODB_URI=mongodb://127.0.0.1:27017
# Database name. Tests use a separate database (see backend/tests/conftest.py).
CLEARCASE_MONGODB_DB=clearcase

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Bind to localhost only for the local MVP. Do not expose publicly without real auth.
CLEARCASE_HOST=127.0.0.1
CLEARCASE_PORT=8000
# Comma-separated origins allowed by CORS (the Vite dev server).
CLEARCASE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Demo identity (NOT authentication)
# ---------------------------------------------------------------------------
# The local MVP uses one server-controlled owner id for all requests so that
# ownership checks exist in every repository/MCP operation from day one.
# Replace with real authentication before any multi-user or public deployment.
CLEARCASE_DEMO_OWNER_ID=demo-user

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
CLEARCASE_MAX_UPLOAD_MB=20
CLEARCASE_MAX_PAGES=200
# Time budget (seconds) for extracting one document, checked after every page. Over budget = status "error",
# retry from the UI. It cannot stop a single page that hangs inside the PDF library.
CLEARCASE_EXTRACTION_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Policy retrieval / embeddings (Phase 4)
# ---------------------------------------------------------------------------
# The embedding model is downloaded ONCE by scripts/download_models.sh into this folder and is
# loaded only from there at runtime (no network at request time). Default: <repo>/.local/models
# CLEARCASE_MODELS_DIR=
# Turn semantic policy search off entirely (the app then reports it as unavailable).
CLEARCASE_EMBEDDINGS_ENABLED=true
# Re-embed passages whose embedding came from a different model revision, in the background at startup.
CLEARCASE_REINDEX_ON_STARTUP=true
# Pretrained model and the exact commit of it we pin. Stored vectors record both, so changing
# either marks existing policy embeddings "stale" until you re-index them in the Policy tab.
# If you change the model, re-run evaluation/tune_retrieval.py: the cutoff below is specific to it.
# CLEARCASE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CLEARCASE_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# Similarity cutoff (a HEURISTIC chosen on a small synthetic dev set; see docs/decisions.md).
# Passages scoring below it are not shown; the app then says the policy does not address the question.
CLEARCASE_RETRIEVAL_MIN_SCORE=0.38
# Lower bound of the reviewer-only "possibly related" list: passages between this and the cutoff are
# offered to the human when nothing reaches the cutoff (never to the assistant). Set it to the cutoff or
# higher to turn the list off.
CLEARCASE_RETRIEVAL_WEAK_MIN_SCORE=0.30
# Largest policy file accepted.
CLEARCASE_MAX_POLICY_KB=200

# ---------------------------------------------------------------------------
# Assistant mode (Phase 5)
# ---------------------------------------------------------------------------
# "demo"  -> scripted, deterministic assistant; no hosted LLM calls, no API key needed.
# "live"  -> uses the hosted provider below; document excerpts WILL be sent to it.
CLEARCASE_ASSISTANT_MODE=demo
# Hosted model provider settings (only used when CLEARCASE_ASSISTANT_MODE=live).
# Values are verified against provider docs in Phase 5 before a default is chosen.
CLEARCASE_LLM_PROVIDER=
CLEARCASE_LLM_API_KEY=
CLEARCASE_LLM_MODEL=
